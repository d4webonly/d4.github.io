  "01_common_05": {
    "id": "01_common_05",
    "messages": [
      {
        "text": "えーっと……今、私が座らされている目の前には、デスクの上に乗ったパソコンがあります。",
        "delay": 2000
      },
      {
        "text": "それと…右側には、「入稿時のチェックリスト」っていう用紙が置いてあります。<br>丸をつける場所に白上質とか、コミックとか書いてある……用紙の種類かな？",
        "delay": 2000
      },
      {
        "text": "左側には、なんだろう？これは……なぞなぞ？100謎みたいな問題集がありますね。",
        "delay": 2000
      },
      {
        "text": "机の奥側には大きい機械が見えます。機械から紙がたくさん出てきているみたいです。",
        "delay": 2000
      },
      {
        "text": "あとは、黒い人影が、紙とか箱とかを運んでいる？ように見えます。話しかけられる……かな？",
        "delay": 2000
      },
      {
        "text": "これって……あなたはこの場所に心当たりはありますか？",
        "delay": 2000
      }
    ],
    "miss": {
      "countAsMiss": false,
      "message": "他のメッセージを送信してください。"
    }
  },
